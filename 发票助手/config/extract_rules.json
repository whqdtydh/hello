{
  "版本": 1,
  "说明": "票面金额/消费日期提取规则（支持热更新：修改保存后下次提取自动生效）。amount_rules 按顺序执行：前 5 条 first-match（组1），末条 mode=max（全部匹配取最大值兜底）。",
  "amount_rules": [
    {
      "name": "价税合计",
      "group": 1,
      "pattern": "价税合计[^0-9]{0,60}?[¥￥]?\\s*(\\d+(?:\\.\\d{1,2})?)",
      "flags": "S"
    },
    {
      "name": "小写",
      "group": 1,
      "pattern": "（?小写）?[¥￥]?\\s*(\\d+(?:\\.\\d{1,2})?)"
    },
    {
      "name": "总计_行程单",
      "group": 1,
      "pattern": "总计[¥￥]?\\s*(\\d+(?:\\.\\d{1,2})?)"
    },
    {
      "name": "合计",
      "group": 1,
      "pattern": "(?:金额)?合计[¥￥]?\\s*(\\d+(?:\\.\\d{1,2})?)"
    },
    {
      "name": "票价",
      "group": 1,
      "pattern": "票价[¥￥]?\\s*(\\d+(?:\\.\\d{1,2})?)"
    },
    {
      "name": "¥兜底",
      "group": 1,
      "mode": "max",
      "pattern": "[¥￥]\\s*(\\d+(?:\\.\\d{1,2})?)"
    }
  ],
  "date_labels": [
    "行程时间",
    "通行时间",
    "出行日期",
    "乘车日期",
    "消费日期",
    "交易时间",
    "行程日期",
    "上车时间"
  ],
  "date_range_pattern": "(20\\d{2})[-/.](\\d{1,2})[-/.](\\d{1,2})\\s*至\\s*20\\d{2}[-/.]\\d{1,2}[-/.]\\d{1,2}",
  "date_cn_pattern": "(20\\d{2})年(\\d{1,2})月(\\d{1,2})日",
  "date_plain_pattern": "(20\\d{2})[-/.](\\d{1,2})[-/.](\\d{1,2})"
}